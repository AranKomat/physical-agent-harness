{
  "episode": "radio-integration-001",
  "goal_text": "Integration diagnostic only: inspect the radio, optionally execute one reviewed radio-policy prefix, and assess visible evidence. The original radio power task is not RGB-verifiable. Do not equate radio visibility with power-on or benchmark success.",
  "goals": [
    {
      "id": "radio_visible",
      "expression": "VISIBLE(radio)",
      "binding": [
        "radio",
        "visibility",
        "visible"
      ],
      "visual_criteria": "The intended radio is actually visible in the supplied current image. This certifies neither power-on, sound, nor successful button operation.",
      "targets": [
        "radio"
      ],
      "observable_from_rgb": true,
      "verifier_qualification": null,
      "verifier_cameras": []
    },
    {
      "id": "radio_power",
      "expression": "ON(radio)",
      "binding": [
        "radio",
        "power",
        "on"
      ],
      "visual_criteria": "Do not infer electrical power or sound from appearance alone.",
      "targets": [
        "radio"
      ],
      "observable_from_rgb": false,
      "verifier_qualification": null
    }
  ],
  "actions": [
    {
      "id": "radio-prefix",
      "instruction": "Execute one already-reviewed bounded prefix from the official task-trained radio policy. Do not change action units or normalization.",
      "targets": [
        "radio"
      ],
      "goal_id": "radio_visible",
      "skill_type": "radio_fixture_prefix",
      "max_wall_s": 30,
      "max_policy_chunks": 1,
      "max_action_steps": 16
    }
  ],
